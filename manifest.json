{
  "manifest_version": 3,
  "name": "Пропуск рекламы в видео",
  "version": "0.7.0",
  "description": "Пропускает спонсорские отрезки YouTube и распознанные рекламные фразы в видео YouTube и TikTok.",
  "permissions": ["activeTab", "offscreen", "scripting", "storage", "tabCapture"],
  "host_permissions": ["https://sponsor.ajay.app/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["detector.js", "youtube.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.tiktok.com/*"],
      "js": ["detector.js", "tiktok.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {},
  "options_ui": { "page": "cloud.html", "open_in_tab": true }
}
